{
  "outputDirectory": "public",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin-v17.html"
    },
    {
      "source": "/staff",
      "destination": "/staff.html"
    },
    {
      "source": "/comandas",
      "destination": "/comandas.html"
    },
    {
      "source": "/promociones",
      "destination": "/promociones.html"
    },
    {
      "source": "/pagina/:slug",
      "destination": "/page.html"
    }
  ]
}
